<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 게시글 제목 입력란 -->
    <EditText
        android:id="@+id/editTextTitleQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="제목을 입력하세요"
        android:padding="16dp" />

    <!-- 게시글 내용 입력란 -->
    <EditText
        android:id="@+id/editTextContentQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/editTextTitleQuestion"
        android:layout_marginTop="16dp"
        android:hint="내용을 입력하세요"
        android:minLines="5"
        android:padding="16dp" />

    <!-- 수정 완료 버튼 -->
    <Button
        android:id="@+id/buttonSaveQuestion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/editTextContentQuestion"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:text="수정 완료" />

    <!-- 수정 취소 버튼 -->
    <Button
        android:id="@+id/buttonCancelQuestion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/editTextContentQuestion"
        android:layout_toStartOf="@id/buttonSaveQuestion"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:text="수정 취소" />

</RelativeLayout>
