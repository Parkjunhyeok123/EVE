<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 충전소 이름 -->
    <TextView
        android:id="@+id/review_station_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textStyle="bold"
        android:padding="16dp" />

    <!-- 제목과 작성 시간을 한 줄에 배치 -->
    <LinearLayout
        android:id="@+id/title_layout_review"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/review_station_name"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- 리뷰 제목 -->
        <TextView
            android:id="@+id/review_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- 작성 시간 -->
        <TextView
            android:id="@+id/review_timestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- 리뷰 내용 -->
    <TextView
        android:id="@+id/review_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/title_layout_review"
        android:layout_marginTop="16dp"
        android:textSize="16sp"
        android:padding="16dp" />

    <!-- 조회수 표시 -->
    <TextView
        android:id="@+id/review_view_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/review_content"
        android:text="조회수: 0"
        android:textSize="14sp"
        android:textColor="@android:color/darker_gray"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp" />

    <!-- 작성자 -->
    <TextView
        android:id="@+id/review_author"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/review_view_count"
        android:layout_marginTop="8dp"
        android:textSize="14sp"
        android:textStyle="italic"
        android:padding="16dp" />

    <!-- 수정하기 버튼 -->
    <Button
        android:id="@+id/edit_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="수정하기"
        android:layout_below="@id/review_author"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"/>

    <!-- 삭제하기 버튼 -->
    <Button
        android:id="@+id/delete_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="삭제하기"
        android:layout_below="@id/review_author"
        android:layout_marginTop="16dp"
        android:layout_toEndOf="@id/edit_button"
        android:layout_marginStart="16dp"/>

    <!-- 댓글 입력 창 -->
    <EditText
        android:id="@+id/comment_edit_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/delete_button"
        android:layout_marginTop="16dp"
        android:hint="댓글을 입력하세요..."
        android:padding="16dp" />

    <!-- 댓글 작성 버튼 -->
    <Button
        android:id="@+id/add_comment_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="댓글 작성"
        android:layout_below="@id/comment_edit_text"
        android:layout_marginTop="16dp"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="16dp"
        android:padding="8dp" />

    <!-- 댓글 리스트를 표시할 RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/comments_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/add_comment_button"
        android:layout_marginTop="16dp"
        android:padding="16dp" />

</RelativeLayout>
