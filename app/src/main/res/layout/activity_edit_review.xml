<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- 충전소 이름 표시란 -->
    <TextView
        android:id="@+id/textViewStationName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="충전소 이름"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingBottom="8dp" />

    <!-- 게시글 제목 입력란 -->
    <EditText
        android:id="@+id/editTextTitleReview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/textViewStationName"
        android:layout_marginTop="8dp"
        android:hint="제목을 입력하세요"
        android:padding="16dp"
        android:maxLines="1" />

    <!-- 게시글 내용 입력란 -->
    <EditText
        android:id="@+id/editTextContentReview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/editTextTitleReview"
        android:layout_marginTop="16dp"
        android:hint="내용을 입력하세요"
        android:minLines="5"
        android:padding="16dp" />

    <!-- 수정 완료 버튼 -->
    <Button
        android:id="@+id/buttonSaveReview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/editTextContentReview"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:text="수정 완료" />

    <!-- 수정 취소 버튼 -->
    <Button
        android:id="@+id/buttonCancelReview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/editTextContentReview"
        android:layout_toStartOf="@id/buttonSaveReview"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:text="수정 취소" />

</RelativeLayout>
